    {
      "name": "24 - Valid Custom Confidence Threshold Query Param (?confidence=0.75)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('Detections meet higher confidence threshold', function () {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.detections && jsonData.detections.length > 0) {",
              "        jsonData.detections.forEach(function(d) {",
              "            if (d.confidence) pm.expect(d.confidence).to.be.at.least(0.75);",
              "        });",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}{{endpoint}}?confidence=0.75",
          "host": ["{{baseUrl}}"],
          "path": ["{{endpoint}}"],
          "query": [
            {
              "key": "confidence",
              "value": "0.75"
            }
